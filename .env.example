# Mot de passe d'accès à la plateforme
APP_PASSWORD=choisis-un-mot-de-passe
# Chaîne aléatoire longue (signature du cookie de session)
AUTH_SECRET=remplace-par-une-chaine-aleatoire-longue

# Compte de service Google Cloud (voir README)
GOOGLE_SERVICE_ACCOUNT_EMAIL=plateforme@ton-projet.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optionnel : IDs des Google Sheets (par défaut ceux du dossier "Plateforme Résidence Suisse — Base de données")
# SHEET_CLIENTS=
# SHEET_ACTIONS=
# SHEET_RESERVATIONS=
# SHEET_STOCK=
# SHEET_TARIFS=
# SHEET_HISTORIQUE_TARIFS=
# SHEET_OBJECTIFS=
# SHEET_PLAN_ACTION=
# SHEET_LISTES=
